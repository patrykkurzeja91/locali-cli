{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@mini-tms/core": ["../core/src/index.ts"]
    },
    "noEmit": true
  },
  "include": ["src/**/*"]
}
