{
  "name": "locali",
  "version": "0.1.0",
  "description": "Locali CLI — push, pull, status, validate for translation files",
  "type": "module",
  "license": "MIT",
  "bin": {
    "locali": "dist/locali.mjs",
    "mini-tms": "dist/locali.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "locali",
    "i18n",
    "localization",
    "tms",
    "translations",
    "cli",
    "crowdin",
    "lokalise"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patrykkurzeja91/i18n-tiny-editor.git",
    "directory": "packages/cli"
  },
  "scripts": {
    "build": "esbuild src/locali.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/locali.mjs",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
